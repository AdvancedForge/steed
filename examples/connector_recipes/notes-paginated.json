{
  "version": 1,
  "name": "Example Paginated Notes",
  "origin": "https://api.fixture.example",
  "authentication": {
    "type": "oauth_pkce",
    "authorization_endpoint": "https://auth.fixture.example/authorize",
    "token_endpoint": "https://auth.fixture.example/token",
    "scopes": [
      "profile",
      "notes.read"
    ]
  },
  "identity": {
    "path": "/me",
    "subject": "/id",
    "label": "/email"
  },
  "tools": [
    {
      "name": "list_notes",
      "description": "Read this account's notes",
      "method": "GET",
      "path": "/notes",
      "response": [
        {
          "label": "notes",
          "pointer": "/items"
        }
      ],
      "pagination": {
        "cursor": "/next",
        "parameter": "cursor",
        "max_pages": 3
      }
    }
  ]
}
