{
  "version": 2,
  "name": "Todoist",
  "origin": "https://api.todoist.com",
  "authentication": {
    "type": "bearer"
  },
  "identity": {
    "path": "/api/v1/user",
    "subject": "/id",
    "label": "/email"
  },
  "tools": [
    {
      "name": "read_task",
      "description": "Read one Todoist task by its exact task ID",
      "method": "GET",
      "path": "/api/v1/tasks/{destination}",
      "response": [
        {
          "label": "id",
          "pointer": "/id"
        },
        {
          "label": "content",
          "pointer": "/content"
        }
      ]
    },
    {
      "name": "list_tasks",
      "description": "Read up to three cursor pages of active tasks. Large accounts can exceed Steed request limits; only the first pages are read.",
      "method": "GET",
      "path": "/api/v1/tasks",
      "response": [
        {
          "label": "tasks",
          "pointer": "/results"
        }
      ],
      "pagination": {
        "cursor": "/next_cursor",
        "parameter": "cursor",
        "max_pages": 3
      }
    },
    {
      "name": "create_task",
      "description": "Create one inbox task from the reviewed draft. Omitting project_id targets the Inbox project, and no project, section or completion is changed.",
      "method": "POST",
      "effect": "write",
      "path": "/api/v1/tasks",
      "destination": "account",
      "request": {
        "content": "artifact.title",
        "description": "artifact.content"
      },
      "response": [
        {
          "label": "id",
          "pointer": "/id"
        },
        {
          "label": "content",
          "pointer": "/content"
        }
      ]
    }
  ]
}
