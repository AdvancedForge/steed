{
  "version": 2,
  "name": "Zotero (one library)",
  "origin": "https://api.zotero.org",
  "authentication": {
    "type": "bearer"
  },
  "identity": {
    "path": "/keys/current",
    "subject": "/userID",
    "label": "/username"
  },
  "tools": [
    {
      "name": "read_item",
      "description": "Read one item by key (e.g. ABCD2345) in the library pinned in this source. Its ID is user-supplied and unchecked against identity: another accessible library may return data; otherwise the service's own error applies. Review the intended library before installation. Read-only.",
      "method": "GET",
      "path": "/users/REPLACE-WITH-YOUR-ZOTERO-USER-ID/items/{destination}",
      "response": [
        {
          "label": "key",
          "pointer": "/key"
        },
        {
          "label": "version",
          "pointer": "/version"
        },
        {
          "label": "item_type",
          "pointer": "/data/itemType"
        },
        {
          "label": "date_added",
          "pointer": "/data/dateAdded"
        },
        {
          "label": "date_modified",
          "pointer": "/data/dateModified"
        }
      ]
    }
  ]
}
