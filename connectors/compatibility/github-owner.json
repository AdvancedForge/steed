{
  "version": 2,
  "name": "GitHub octocat owner-pinned starter",
  "origin": "https://api.github.com",
  "authentication": {
    "type": "bearer"
  },
  "identity": {
    "path": "/user",
    "subject": "/id",
    "label": "/login"
  },
  "tools": [
    {
      "name": "read_repository",
      "description": "Read one repository under the reviewed octocat owner",
      "method": "GET",
      "path": "/repos/octocat/{destination}",
      "response": [
        {
          "label": "id",
          "pointer": "/id"
        },
        {
          "label": "name",
          "pointer": "/full_name"
        },
        {
          "label": "url",
          "pointer": "/html_url"
        }
      ]
    },
    {
      "name": "create_issue",
      "description": "Create an issue under the reviewed octocat owner",
      "method": "POST",
      "effect": "write",
      "path": "/repos/octocat/{destination}/issues",
      "destination": "resource_id",
      "request": {
        "title": "artifact.title",
        "body": "artifact.content"
      },
      "response": [
        {
          "label": "id",
          "pointer": "/id"
        },
        {
          "label": "number",
          "pointer": "/number"
        },
        {
          "label": "url",
          "pointer": "/html_url"
        }
      ]
    }
  ]
}
